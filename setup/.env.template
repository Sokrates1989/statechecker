# =============================================================================
# 🔧 Statechecker - Environment Configuration
# =============================================================================
# Copy this file to .env in the project root and customize as needed
# =============================================================================

# Debugging.
DEBUG_ENABLED=true

# --- Docker Image Configuration ---
IMAGE_NAME=sokrates1989/statechecker
IMAGE_VERSION=latest
WEB_IMAGE_NAME=sokrates1989/statechecker-web
WEB_IMAGE_VERSION=latest

# --- Database Configuration ---
DB_HOST=db
DB_PORT=3306
# Timeout (seconds) for waiting until DB is reachable on startup.
DB_WAIT_TIMEOUT=60
DB_NAME=state_checker
DB_USER=state_checker
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# --- API Configuration ---
REST_API_PORT=8787
SERVER_AUTHENTICATION_TOKEN=change_me_random_auth_token

# --- Admin Website (nginx) ---
WEB_PORT=8788

# --- Logging ---
TIMEZONE=Europe/Berlin

# --- Check Frequency ---
CHECK_WEBSITES_EVERY_X_MINUTES=30
CHECK_GOOGLEDRIVE_EVERY_X_MINUTES=60

# --- Messaging ---
STATUS_MESSAGES_TIME_OFFSET_PERCENTAGE=2.5

# --- Email Notifications ---
EMAIL_ENABLED=false
EMAIL_SENDER_USER=some.mail@domain.com
EMAIL_SENDER_PASSWORD=
EMAIL_SENDER_HOST=smtp.example.com
EMAIL_SENDER_PORT=587
EMAIL_RECIPIENTS_ERROR=error@felicitas-wisdom.com
EMAIL_RECIPIENTS_INFORMATION=info@felicitas-wisdom.com

# --- Telegram Notifications ---
TELEGRAM_ENABLED=false
TELEGRAM_STATUS_MESSAGES_EVERY_X_MINUTES=60
TELEGRAM_SENDER_BOT_TOKEN=change_me_telegram_token
TELEGRAM_RECIPIENTS_ERROR_CHAT_IDS=-123456789
TELEGRAM_RECIPIENTS_INFO_CHAT_IDS=-123456789

# --- phpMyAdmin Configuration (local development) ---
PHPMYADMIN_PORT=8080

# --- Keycloak Authentication (Web UI) ---
# When enabled, web UI uses Keycloak SSO instead of token input
# stateChecker-client will continue to use SERVER_AUTHENTICATION_TOKEN
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=http://localhost:9090
KEYCLOAK_REALM=statechecker
KEYCLOAK_CLIENT_ID=statechecker-frontend
KEYCLOAK_BACKEND_CLIENT_ID=statechecker-backend
KEYCLOAK_CLIENT_SECRET=
# Internal URL for Docker networking (e.g., http://keycloak:9090)
KEYCLOAK_INTERNAL_URL=http://host.docker.internal:9090

# --- Statechecker Config (JSON) ---
# This can also be set in config.txt file
STATECHECKER_SERVER_CONFIG=
